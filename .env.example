APP_NAME="Founder Copilot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
# Dedicated Founder Copilot database. Never use a Vee-Care database or connection.
DB_DATABASE=ai_founder_copilot
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SANCTUM_STATEFUL_DOMAINS=localhost:3000
FRONTEND_URL=http://localhost:3000

# --- AI provider config (server-side ONLY — never exposed to the frontend) ---
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_MAX_CONTEXT_ACTIVITIES=15
AI_MAX_CONTEXT_MEMORIES=25
